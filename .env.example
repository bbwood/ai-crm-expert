# API Configuration
PORT=3000
NODE_ENV=development

# AI Provider Selection for message generation (anthropic or gemini)
# Recommended: anthropic (Claude) for best quality
AI_PROVIDER=anthropic

# AI API Keys
# PDF parsing will fallback through: Claude → Gemini → OpenAI → Regex
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database (optional - for production)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_crm_expert

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
